{
  "cleanUrls": true,
  "redirects": [
    { "source": "/product/:slug", "destination": "/coupons/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/site/:slug", "destination": "/site" },
    { "source": "/coupons/:slug", "destination": "/coupons" },
    { "source": "/category/:slug", "destination": "/category" },
    { "source": "/about", "destination": "/page" },
    { "source": "/privacy-policy", "destination": "/page" },
    { "source": "/terms-of-use", "destination": "/page" },
    { "source": "/contact", "destination": "/page" },
    { "source": "/blog/:slug", "destination": "/blogpost" }
  ]
}
