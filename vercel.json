{
  "rewrites": [
    { "source": "/site/:slug", "destination": "/site.html" },
    { "source": "/product/:slug", "destination": "/product.html" },
    { "source": "/category/:slug", "destination": "/category.html" },
    { "source": "/about", "destination": "/page.html" },
    { "source": "/privacy-policy", "destination": "/page.html" },
    { "source": "/terms-of-use", "destination": "/page.html" },
    { "source": "/contact", "destination": "/page.html" }
  ]
}
